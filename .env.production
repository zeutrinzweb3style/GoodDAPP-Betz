# Build-time defaults for `vite build` (Vite loads .env.production automatically).
#
# Public, client-side values only - never put a secret in this file, it is
# compiled into the bundle.
#
# Anything set in the Vercel dashboard (or any other CI) takes priority over
# this file, so a deployment can override every line below without editing it.
#
# Why this file exists: index.html uses Vite's HTML env replacement
# (`<script type="module" src="%REACT_APP_INDEXJS%">`). Without the variable the
# placeholder survives into the HTML and the build fails with
# "Rollup failed to resolve import %REACT_APP_INDEXJS%".

# Wallet app entry. Use /src/index.fv.jsx only for the standalone
# face-verification page.
REACT_APP_INDEXJS=/src/index.jsx

REACT_APP_ENV=production
REACT_APP_NETWORK=production-celo
REACT_APP_SERVER_URL=https://goodserver.gooddollar.org
REACT_APP_REALM_APP_ID=wallet_prod-obclo
REACT_APP_DASHBOARD_URL=https://dashboard.gooddollar.org
REACT_APP_CERAMIC_NODE_URL=https://ceramic.gooddollar.org

# On-chain support chat (see docs/SUPPORT_CHAT_PROPOSAL.md).
# The contract address is deployment specific: set REACT_APP_SUPPORT_CHAT_CONTRACT
# in the Vercel dashboard after running scripts/deploy-support-chat.js.
REACT_APP_SUPPORT_TG_URL=https://t.me/GoodDollarX

# Optional but recommended: pin the public origin so share/receive links and the
# service worker always point at production, even from a preview deployment.
# Falls back to window.location.origin when empty.
# REACT_APP_PUBLIC_URL=https://your-domain.example
